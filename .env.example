# ═══════════════════════════════════════════════════════════
# WinExtraFlow — Environment Variables
# Copy to .env and fill in real values before running
# ═══════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=winextraflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=winextraflow
DATABASE_URL=postgresql+asyncpg://winextraflow:CHANGE_ME@localhost:5432/winextraflow

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security (REQUIRED in production) ───────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Separate key for encrypting exchange API keys
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=
# JWT token lifetime in minutes (max 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Admin Seed (set to create admin on first startup) ───
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── CORS (comma-separated origins for production) ──────
ALLOWED_ORIGINS=http://localhost:3000

# ─── TradingView ─────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=

# ─── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ─── Stripe Payments ─────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Promo Codes (format: CODE:DAYS,CODE:DAYS) ──────────
PROMO_CODES=WELCOME7:7,TRIAL3:3

# ─── App Settings ────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
FRONTEND_URL=http://localhost:3000
