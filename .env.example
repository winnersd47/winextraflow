# ═══════════════════════════════════════════════════════════
# WinExtraFlow — Environment Variables
# Copy to .env and fill in real values before running
# ═══════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=winextraflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=winextraflow
DATABASE_URL=postgresql+asyncpg://winextraflow:CHANGE_ME@localhost:5432/winextraflow

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security (REQUIRED in production) ───────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Separate key for encrypting exchange API keys
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=
# JWT token lifetime in minutes (max 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Admin Seed (set to create admin on first startup) ───
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── CORS (comma-separated origins for production) ──────
ALLOWED_ORIGINS=http://localhost:3000

# ─── TradingView ─────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=

# ─── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=30159716
TELEGRAM_API_HASH=6c9fff016bc4e7775ca85ff5316397f8
TELEGRAM_PHONE=

# ─── YooKassa (RU payments: cards, SBP, SberPay) ────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── CryptoCloud (crypto payments: USDT, BTC, ETH) ──────
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=

# ─── Prodamus (international cards: USD, EUR) ───────────
PRODAMUS_SECRET_KEY=
PRODAMUS_PAYFORM_URL=

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Promo Codes (format: CODE:DAYS,CODE:DAYS) ──────────
PROMO_CODES=WELCOME7:7,TRIAL3:3

# ─── App Settings ────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
FRONTEND_URL=http://localhost:3000

# ── MT5 bridge ────────────────────────────────────────────────────────────
# Shared secret between the Python bridge and the MQL5 expert. REQUIRED to bind
# anything but 127.0.0.1: every `analyze` command spends OPENROUTER_API_KEY, so an
# unauthenticated port is an open wallet. Put the same value in the EA's inputs.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_BRIDGE_TOKEN=

# ── Paid subscriptions ────────────────────────────────────────────────────
# Off until the platform has a measured record of profitable signals. All checkout
# endpoints return 503 while this is false. Do not enable without a run of
# scripts/wef_validation.py behind it.
PAID_SUBSCRIPTIONS_ENABLED=false

# LLM fallback parser budget per backfill run (job runs every 30 min = 48 runs/day).
# The regex parsers cover four channels; everything else needs the LLM. Each message
# is tried ONCE — llm_parse_ledger.json remembers attempts, so cost scales with new
# unparsed messages, not with run count.
#   free tier, no credits ($0)  -> 50 requests/day TOTAL, set this to 0 or 1
#   free tier, $10 topped up    -> 1000 requests/day, 10 is comfortable
LLM_PARSE_PER_RUN=10

# Which crypto exchange to try first for prices and candles: binance | bybit.
# Both are always tried — this only sets the order, so one being unreachable is a
# slowdown rather than an outage. Set to bybit on Russian infrastructure: Binance
# withdrew from that market and may answer differently there than on your network.
CRYPTO_PRIMARY=binance

# ── GoClaw AI Agent Gateway ────────────────────────────
# Optional. When set, Telegram signals are routed through GoClaw instead of
# (or before falling back to) the direct Telegram Bot API. This enables
# multi-agent orchestration: message queuing, rate-limit pooling, A/B routing,
# and cross-agent audit logging.
# Leave both empty to use the direct Telegram Bot API only (default behaviour).
GOCLAW_URL=
GOCLAW_TOKEN=
