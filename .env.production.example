# Database
POSTGRES_USER=winextraflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=winextraflow
DATABASE_URL=postgresql+asyncpg://winextraflow:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/winextraflow

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — ОБЯЗАТЕЛЬНО СМЕНИТЬ!
SECRET_KEY=CHANGE_ME_RANDOM_32_CHAR_STRING_HERE

# App
APP_ENV=production
APP_DEBUG=false

# Domain
DOMAIN=winextraflow.com
FRONTEND_URL=https://winextraflow.com

# Telegram (опционально)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Stripe (опционально)
