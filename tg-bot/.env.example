# WinExtraFlow Telegram Bot Configuration
# Copy this file to .env and fill in the values

BOT_TOKEN=your_bot_token_here

# Channel IDs (get via @getidsbot or @RawDataBot)
CHANNEL_SIGNALS_ID=-100xxxxxxxxxx
CHANNEL_VIP_ID=-100xxxxxxxxxx
GROUP_AIGC_ID=-100xxxxxxxxxx

# Tags that trigger forwarding to AI Growth Club
FORWARD_TAGS=#repost,#aigc

# Content wave day (1-28)
WAVE_DAY=1
